# Jack and the Beanstalk — environment configuration
#
# Copy to `.env` and fill in real values. `.env` is gitignored and must never be
# committed. On Render you set these same variables in the dashboard instead.

# --- Image provider ---------------------------------------------------------------
# Which provider backs the generation service: "mock" or "gemini".
# "mock" runs the whole app with zero network calls and no API key, so you can
# develop and test the UI offline. "gemini" talks to the real model.
IMAGE_PROVIDER=mock

# Google AI Studio key. Free tier available: https://aistudio.google.com/apikey
# Only required when IMAGE_PROVIDER=gemini.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-image

# --- App --------------------------------------------------------------------------
APP_ENV=development
# Cap on upload size, in megabytes. Guards against someone POSTing a 2GB photo.
MAX_UPLOAD_MB=10
# How long a single generation may run before we give up, in seconds.
GENERATION_TIMEOUT_SECONDS=180
# Set to "true" in production so generated files are served with no-cache headers.
FORCE_CACHE_CONTROL=false