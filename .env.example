# Jack and the Beanstalk — environment configuration
#
# Copy to `.env` and fill in real values. `.env` is gitignored and must never be
# committed. On Render you set these same variables in the dashboard instead.

# --- Image provider ---------------------------------------------------------------
# Which provider backs the generation service: "mock", "openai" or "gemini".
# "mock" runs the whole app with zero network calls and no API key, so you can
# develop and test the UI offline.
IMAGE_PROVIDER=mock

# OpenAI (the default real provider). Key: https://platform.openai.com/api-keys
OPENAI_API_KEY=
# Cheapest per-call figure OpenAI publishes: $0.00588 for a 1K output at
# quality=low (196 output tokens at $30 per 1M image output tokens).
# Move up a tier with quality=medium|high|xhigh|max if likeness needs it.
OPENAI_MODEL=gpt-image-2.5-flare
OPENAI_QUALITY=low

# Google Gemini — the alternative. Key: https://aistudio.google.com/apikey
# Only needed when IMAGE_PROVIDER=gemini. Note there is no free tier for image
# generation: you must enable billing, and since March 2026 that is a prepay
# plan with a $5 minimum.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite-image

# --- App --------------------------------------------------------------------------
APP_ENV=development
# Cap on upload size, in megabytes. Guards against someone POSTing a 2GB photo.
MAX_UPLOAD_MB=10

# Wall-clock ceiling for ONE /api/generate request, in seconds.
# This is a single budget covering both waiting for a free slot and the two
# model calls together, not one allowance each. The same value is applied to
# the provider's HTTP client, so a slow generation really does abort its socket
# rather than leaving a thread burning tokens in the background.
# Set high: two image calls should normally finish well inside it.
GENERATION_TIMEOUT_SECONDS=600

# How many generations may run at once per process. Requests beyond this queue;
# if one waits longer than its remaining budget it gets 429 and is told to
# retry, without any request reaching the image model and without costing you
# anything. Raise it only if your provider's rate limits allow more.
MAX_CONCURRENT_GENERATIONS=2

# Where generated artefacts are stored. Render's local disk is ephemeral, but
# this keeps the setting explicit and makes Docker/local runs predictable.
STORAGE_DIR=./storage
